# LiveKit server (a local dev instance is expected at this URL/key/secret;
# docker-compose.yml publishes it on 8890-8892 to avoid clashing with
# another LiveKit dev server on the conventional 7880-7882)
LIVEKIT_URL=ws://localhost:8890
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me-to-a-32-plus-character-secret

# Provider selection (registry keys — see internal/provider/registry.go)
STT_PROVIDER=qwen
LLM_PROVIDER=openai_compat
TTS_PROVIDER=qwen

# DashScope / Qwen realtime STT + TTS (native WebSocket protocol)
DASHSCOPE_API_KEY=sk-your_dashscope_api_key
# Or send speech through ai-gateway-llm, so a tenant's own speech key pays for
# its calls: its realtime proxy and this worker's client key there. Each socket
# carries the call's run token, minted with AUTH_CLIENT_SECRET.
# SPEECH_URL=ws://host.docker.internal:7200/v1/audio/realtime
# SPEECH_API_KEY=
DASHSCOPE_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
QWEN_STT_MODEL=qwen3-asr-flash-realtime
QWEN_TTS_MODEL=qwen3-tts-flash-realtime
QWEN_TTS_VOICE=Cherry

# OpenAI speech: set STT_PROVIDER=openai and/or TTS_PROVIDER=openai. The key
# defaults to OPENAI_API_KEY; the base URL is separate from the LLM's.
# OPENAI_SPEECH_BASE_URL=https://api.openai.com/v1
# OPENAI_SPEECH_API_KEY=
# OPENAI_STT_MODEL=gpt-4o-mini-transcribe
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy

# LLM: any OpenAI-compatible endpoint. DashScope's compatible-mode endpoint
# runs Qwen chat models; swap these three for OpenAI, Doubao, DeepSeek, etc.
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=sk-your_dashscope_api_key
OPENAI_MODEL=qwen-plus

# To send model calls through ai-gateway-llm, for its audit, usage and limits:
# OPENAI_BASE_URL=http://localhost:7200/v1
# OPENAI_API_KEY=a key from the clients section of ai-gateway's config

# LLM: agent-pi, a stateful agent server. Set LLM_PROVIDER=agent_pi to use it.
# It owns the conversation, so -system-prompt has no effect: edit the profile's
# prompt there instead. Each caller reaches agent-pi as themselves: room admission
# gives them an agent grant, and this process exchanges it at the auth service
# using the AUTH_ settings below. agent-pi must run with AUTH_KIND=jwt and
# JWT_AUDIENCE=t10,agent-pi. A participant who joined without admission gets no
# agent replies. A call in a room named conv-<session ID> continues that session,
# on its own model. Any other room uses a voice session. From the agent
# container, a server on the host is http://host.docker.internal:9800/agent.
#   WHEN_BUSY  what a message does when the agent is already working:
#              auto       abort text being generated and answer at once, but
#                         let running tools finish first.
#              interrupt  abort everything, tools included. Only for tools that
#                         are safe to abandon: the model is told they were
#                         aborted even if they had already acted, and will tell
#                         the user an email it already sent was cancelled.
#              steer      join after the current tool round, or else wait for
#                         the current answer to finish generating.
#              followUp   wait for the whole run to finish.
# See docs/AGENT-PI-PROVIDER.md.
# The agent in Docker Compose reads AGENT_PI_DOCKER_URL and AUTH_DOCKER_URL
# instead, which default to host.docker.internal.
AGENT_PI_URL=http://localhost:9800/agent
# With more than one agent-pi replica, name each one as workbench does. Sessions
# go to their own replica, and new ones to AGENT_PI_URL.
# AGENT_URLS=assistant.r0=http://agent-pi-0:9800,assistant.r1=http://agent-pi-1:9800
# Or read the same routing document as ai-gateway-agent, which replaces AGENT_URLS.
# AGENT_ROUTES_FILE=/etc/t10/agents.json
AGENT_PI_PROFILE=voice
AGENT_PI_WHEN_BUSY=auto

# Auth service. Used only with LLM_PROVIDER=agent_pi. The secret comes from
# `authctl service-add`; the auth repo's compose file seeds the name below with
# its dev default, dev-only-t10-livekit-agent-secret-change-me.
AUTH_URL=http://localhost:8081
AUTH_CLIENT_ID=t10-livekit-agent
AUTH_CLIENT_SECRET=

# Live-call VAD tuning. MIN_SILENCE_MS is how long a pause has to last
# before the agent treats you as finished. It no longer has to be set
# defensively high: an utterance cut short by a mid-sentence pause is merged
# with what you say next rather than answered on its own (see
# LiveCallController.coalesce), so this is now purely a responsiveness knob.
# BARGE_IN_MIN_SPEECH_MS is the separate, longer threshold for interrupting
# the agent while it is already speaking — raise it if room noise, or the
# agent's own voice through an open speaker, keeps cutting it off.
VAD_ENERGY_THRESHOLD=500
VAD_MIN_SPEECH_MS=200
VAD_MIN_SILENCE_MS=700
VAD_BARGE_IN_MIN_SPEECH_MS=400

# Live-call pipeline tuning (see engine.LiveConfig).
#   PREROLL_MS       audio kept from before speech was detected and replayed
#                    into the recognizer, so the first syllable isn't clipped.
#   MAX_LEAD_MS      how far ahead of what you're hearing synthesized audio
#                    may be queued. Lower = captions track the voice more
#                    closely and interruptions cut less; too low risks gaps.
#   TTS_CONCURRENCY  simultaneous synthesis calls. Each one is its own
#                    provider WebSocket, and they queue against each other at
#                    the far end — measured at 18-way concurrency, chunks of
#                    three characters were taking 7s and one timed out
#                    outright. Playback is ordered anyway, so a small number
#                    here is both faster and cheaper.
#   MIN/MAX_CHUNK_RUNES  how much text is batched per synthesis call. The
#                    first chunk of every reply ignores the minimum, so
#                    time-to-first-audio doesn't pay for the batching.
LIVE_PREROLL_MS=400
LIVE_MAX_LEAD_MS=700
TTS_CONCURRENCY=2
TTS_TIMEOUT_MS=8000
LIVE_MIN_CHUNK_RUNES=40
LIVE_MAX_CHUNK_RUNES=180

LOG_LEVEL=info

# OpenTelemetry: OTLP/gRPC host:port (no scheme) to export traces and
# metrics to. Leave unset to disable tracing/metrics export entirely (logs
# still get session_id and turn_id either way — see internal/telemetry).
# docker-compose.yml sets this to otel-collector:4317 for the containerized
# agent automatically; uncomment for `go run ./cmd/agent` on the host once
# `docker compose up otel-collector jaeger prometheus` is running (their
# ports are published to the host — see docker-compose.yml).
# OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317

# Voice workers. One worker needs none of this. More than one needs Redis, which
# gives each room to one worker.
# REDIS_URL=redis://localhost:6379
# Rooms one worker serves at once. 0 means no limit, until a load test sets one.
VOICE_MAX_CALLS=0
# How long calls run on after SIGTERM. The termination grace period must exceed it.
VOICE_DRAIN_SECONDS=600

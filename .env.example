# LiveKit server (a local dev instance is expected at this URL/key/secret;
# docker-compose.yml publishes it on 8880-8882 to avoid clashing with
# another LiveKit dev server on the conventional 7880-7882)
LIVEKIT_URL=ws://localhost:8880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me-to-a-32-plus-character-secret

# Provider selection (registry keys — see internal/provider/registry.go)
STT_PROVIDER=qwen
LLM_PROVIDER=openai_compat
TTS_PROVIDER=qwen

# DashScope / Qwen realtime STT + TTS (native WebSocket protocol)
DASHSCOPE_API_KEY=sk-your_dashscope_api_key
DASHSCOPE_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
QWEN_STT_MODEL=qwen3-asr-flash-realtime
QWEN_TTS_MODEL=qwen3-tts-flash-realtime
QWEN_TTS_VOICE=Cherry

# LLM: any OpenAI-compatible endpoint. DashScope's compatible-mode endpoint
# runs Qwen chat models; swap these three for OpenAI, Doubao, DeepSeek, etc.
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=sk-your_dashscope_api_key
OPENAI_MODEL=qwen-plus

# Live-call VAD tuning. MIN_SILENCE_MS is how long a pause has to last
# before the agent treats you as finished. It no longer has to be set
# defensively high: an utterance cut short by a mid-sentence pause is merged
# with what you say next rather than answered on its own (see
# LiveCallController.coalesce), so this is now purely a responsiveness knob.
# BARGE_IN_MIN_SPEECH_MS is the separate, longer threshold for interrupting
# the agent while it is already speaking — raise it if room noise, or the
# agent's own voice through an open speaker, keeps cutting it off.
VAD_ENERGY_THRESHOLD=500
VAD_MIN_SPEECH_MS=200
VAD_MIN_SILENCE_MS=700
VAD_BARGE_IN_MIN_SPEECH_MS=400

# Live-call pipeline tuning (see engine.LiveConfig).
#   PREROLL_MS       audio kept from before speech was detected and replayed
#                    into the recognizer, so the first syllable isn't clipped.
#   MAX_LEAD_MS      how far ahead of what you're hearing synthesized audio
#                    may be queued. Lower = captions track the voice more
#                    closely and interruptions cut less; too low risks gaps.
#   TTS_CONCURRENCY  simultaneous synthesis calls. Each one is its own
#                    provider WebSocket, and they queue against each other at
#                    the far end — measured at 18-way concurrency, chunks of
#                    three characters were taking 7s and one timed out
#                    outright. Playback is ordered anyway, so a small number
#                    here is both faster and cheaper.
#   MIN/MAX_CHUNK_RUNES  how much text is batched per synthesis call. The
#                    first chunk of every reply ignores the minimum, so
#                    time-to-first-audio doesn't pay for the batching.
LIVE_PREROLL_MS=400
LIVE_MAX_LEAD_MS=700
TTS_CONCURRENCY=2
TTS_TIMEOUT_MS=8000
LIVE_MIN_CHUNK_RUNES=40
LIVE_MAX_CHUNK_RUNES=180

LOG_LEVEL=info

# OpenTelemetry: OTLP/gRPC host:port (no scheme) to export traces and
# metrics to. Leave unset to disable tracing/metrics export entirely (logs
# still get a correlation ID either way — see internal/telemetry).
# docker-compose.yml sets this to otel-collector:4317 for the containerized
# agent automatically; uncomment for `go run ./cmd/agent` on the host once
# `docker compose up otel-collector jaeger prometheus` is running (their
# ports are published to the host — see docker-compose.yml).
# OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
